{
  "name": "@cofold/store-file",
  "version": "0.1.0",
  "description": "File-backed Store for @cofold/agents: JSONL per session and run, writer.lock with a heartbeat, plus fileSkillSource.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "src", "!src/**/*.test.ts", "!src/**/*.test-d.ts", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": { "@cofold/agents": "workspace:*" },
  "devDependencies": { "@cofold/agents": "workspace:*" },
  "publishConfig": { "access": "public" }
}
