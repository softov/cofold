{
  "name": "@cofold/copapo",
  "version": "0.1.0",
  "description": "A coding agent at the terminal, on the cofold harness or on Claude Code. Use it as a screen, from the shell, or as an ACP agent.",
  "license": "MIT",
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "funding": "https://github.com/sponsors/softov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/cofold.git",
    "directory": "packages/copapo"
  },
  "homepage": "https://github.com/softov/cofold#readme",
  "bugs": {
    "url": "https://github.com/softov/cofold/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "copapo": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "dev": "pnpm build && node dist/main.js",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cofold/agents": "workspace:^",
    "@cofold/commands": "workspace:^",
    "@cofold/config": "workspace:^",
    "@cofold/mcp-client": "workspace:^",
    "@cofold/model-openai-compat": "workspace:^",
    "@cofold/sdk": "workspace:^",
    "@cofold/store-file": "workspace:^",
    "@cofold/terminal": "workspace:^",
    "@cofold/tools": "workspace:^",
    "@textui/chat": "^0.9.1",
    "@textui/core": "^0.9.1",
    "@textui/terminal": "^0.9.1",
    "@textui/widgets": "^0.9.1"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.273"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.273",
    "@textui/testing": "^0.9.1"
  }
}
