{
  "name": "@cofold/mcp-client",
  "version": "0.1.0",
  "description": "Use the tools of MCP servers from a @cofold/agents agent: stdio and Streamable HTTP, with no dependency, as one capability.",
  "license": "MIT",
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "funding": "https://github.com/sponsors/softov",
  "homepage": "https://github.com/softov/cofold#readme",
  "bugs": {
    "url": "https://github.com/softov/cofold/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/cofold.git",
    "directory": "packages/mcp-client"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "tools",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@cofold/agents": ">=0.4 <0.5"
  },
  "devDependencies": {
    "@cofold/agents": "workspace:*",
    "@cofold/commands": "workspace:^",
    "@cofold/mcp": "workspace:^",
    "@cofold/sdk": "workspace:^",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.3.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
