{
  "name": "@cofold/agents",
  "version": "0.1.1",
  "description": "Agent runtime: contracts, loop, run handle, step log.",
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "homepage": "https://github.com/softov/cofold#readme",
  "funding": "https://github.com/sponsors/softov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/cofold.git",
    "directory": "packages/agents"
  },
  "bugs": {
    "url": "https://github.com/softov/cofold/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./testing/store-conformance": {
      "types": "./dist/testing/store-conformance.d.ts",
      "default": "./dist/testing/store-conformance.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cofold/sdk": "workspace:^"
  }
}
