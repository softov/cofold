{
  "name": "@facio/papo",
  "version": "0.0.1",
  "description": "papo: talk to an agent that runs in this process, at a terminal or from a shell.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "papo": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "dev": "pnpm build && node dist/main.js",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@facio/agents": "workspace:^",
    "@facio/commands": "workspace:^",
    "@facio/config": "workspace:^",
    "@facio/model-openai-compat": "workspace:^",
    "@facio/sdk": "workspace:^",
    "@facio/store-file": "workspace:^",
    "@facio/terminal": "workspace:^",
    "@facio/tools": "workspace:^",
    "@textui/chat": "link:../../../textui/packages/chat",
    "@textui/core": "link:../../../textui/packages/core",
    "@textui/terminal": "link:../../../textui/packages/terminal",
    "@textui/widgets": "link:../../../textui/packages/widgets"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.273",
    "@textui/testing": "link:../../../textui/packages/testing"
  }
}
