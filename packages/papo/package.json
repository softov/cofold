{
  "name": "@cofold/papo",
  "version": "0.0.1",
  "description": "papo: talk to an agent that runs in this process, at a terminal or from a shell.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "papo": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "dev": "pnpm build && node dist/main.js",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cofold/agents": "workspace:^",
    "@cofold/commands": "workspace:^",
    "@cofold/config": "workspace:^",
    "@cofold/model-openai-compat": "workspace:^",
    "@cofold/sdk": "workspace:^",
    "@cofold/store-file": "workspace:^",
    "@cofold/terminal": "workspace:^",
    "@cofold/tools": "workspace:^",
    "@textui/chat": "^0.6.1",
    "@textui/core": "^0.6.1",
    "@textui/terminal": "^0.6.1",
    "@textui/widgets": "^0.6.1"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.273"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.273",
    "@textui/testing": "^0.6.1"
  }
}
