{
  "name": "@doopx/terminal",
  "version": "0.2.0",
  "type": "module",
  "description": "The terminal rendering of a command registry: argv in, help, completion, output modes and exit codes out.",
  "license": "MIT",
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "funding": "https://github.com/sponsors/softov",
  "homepage": "https://github.com/softov/doopx#readme",
  "bugs": {
    "url": "https://github.com/softov/doopx/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/doopx.git",
    "directory": "packages/terminal"
  },
  "keywords": [
    "cli",
    "command-line",
    "argv",
    "completion",
    "help",
    "typescript",
    "zero-dependency"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@doopx/commands": "workspace:^"
  }
}
