{
  "name": "@doopx/sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "What the doopx packages share: JSON Schema and the one validator that holds a value to it, the Standard Schema interface.",
  "license": "MIT",
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/doopx.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/softov/doopx#readme",
  "bugs": {
    "url": "https://github.com/softov/doopx/issues"
  },
  "keywords": [
    "json-schema",
    "standard-schema",
    "types",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist"
  }
}
