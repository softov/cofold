{
  "name": "@cofold/model-openai-compat",
  "version": "0.1.1",
  "description": "Chat Completions model adapter for @cofold/agents (OpenRouter, LM Studio, any compatible server).",
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "homepage": "https://github.com/softov/cofold#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/cofold.git",
    "directory": "packages/model-openai-compat"
  },
  "bugs": {
    "url": "https://github.com/softov/cofold/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@cofold/agents": "^0.1"
  },
  "devDependencies": {
    "@cofold/agents": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}