{
  "name": "@cofold/commands",
  "version": "0.2.1",
  "type": "module",
  "description": "A command is data: the declaration, the registry, input, the argv grammar, coercion and schema, rendered by every surface.",
  "license": "MIT",
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "funding": "https://github.com/sponsors/softov",
  "homepage": "https://github.com/softov/cofold#readme",
  "bugs": {
    "url": "https://github.com/softov/cofold/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/cofold.git",
    "directory": "packages/commands"
  },
  "keywords": [
    "cli",
    "command-line",
    "framework",
    "argv",
    "parser",
    "json-schema",
    "validation",
    "typescript",
    "zero-dependency"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "default": "./dist/docs.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cofold/sdk": "workspace:^"
  },
  "devDependencies": {
    "zod": "4.3.6"
  }
}
