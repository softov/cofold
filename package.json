{
  "name": "softcli",
  "version": "0.1.0",
  "type": "module",
  "description": "One command declaration, many surfaces: CLI, MCP, docs, completion.",
  "license": "MIT",
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "keywords": [
    "cli",
    "command-line",
    "mcp",
    "model-context-protocol",
    "argv",
    "parser",
    "completion",
    "openapi",
    "zero-dependency"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./docs": {
      "types": "./dist/docs/index.d.ts",
      "default": "./dist/docs/index.js"
    },
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "default": "./dist/remote/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run examples && npm run test",
    "clean": "rm -rf dist examples/dist",
    "coverage": "vitest run src examples --coverage --coverage.include='src/**'",
    "examples": "npm run build && tsc -p examples/tsconfig.json",
    "test": "vitest run src examples",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
